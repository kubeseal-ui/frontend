# Environment Variables for kubeseal-ui frontend
# Copy this file to .env and fill in your values

# OIDC Authentication
# URL of your OIDC provider's authorization endpoint (e.g., https://auth.example.com/oauth2/authorize)
# VITE_OIDC_AUTHORIZATION_URL=

# URL of your OIDC provider's token endpoint (e.g., https://auth.example.com/oauth2/token)
# VITE_OIDC_TOKEN_URL=

# URL of your OIDC provider's userinfo endpoint (e.g., https://auth.example.com/oauth2/userinfo)
# VITE_OIDC_USERINFO_URL=

# OIDC Client ID (registered with your provider)
# VITE_OIDC_CLIENT_ID=

# OIDC Redirect URL (must match what's registered with your provider)
# VITE_OIDC_REDIRECT_URL=

# API Backend URL (the kubeseal-ui/api service)
# VITE_API_URL=https://api.example.com

# Optional: Cookie domain for cross-subdomain auth
# VITE_COOKIE_DOMAIN=.example.com

# Optional: Disable auto-logout on 401 (for testing)
# VITE_DISABLE_LOGOUT_ON_401=true